generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WorkflowRun {
  id        String     @id @default(uuid())
  prompt    String
  status    String     @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  result    String?    // The final markdown output
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      AgentLog[]
}

model AgentLog {
  id            String      @id @default(uuid())
  workflowRunId String
  agentName     String      // e.g., "Researcher", "Writer", "Reviewer"
  action        String      // e.g., "Searching web", "Drafting content"
  content       String      // The raw thought, result, or payload
  createdAt     DateTime    @default(now())

  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id])
}
